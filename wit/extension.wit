// Emporium provider-based extension interfaces.
// VS Code style: five interfaces + four additive worlds.
package emporium:extensions@0.4.0;

// ----------------------------------------------------------------------------
// Shared types (referenced by multiple interfaces — both exports and imports).
// Lifted out to its own interface so `host-data` (an import) can reference
// `column-def` without dragging `tool-provider` into the import set of
// `full-extension` (which would collide with its export of tool-provider).
// ----------------------------------------------------------------------------

interface types {
    record column-def {
        name: string,
        alias: string,
        dtype: string,
    }
}

// ----------------------------------------------------------------------------
// Exported interfaces (extension -> host)
// ----------------------------------------------------------------------------

// Identity, configuration, and introspection. Every extension exports this.
interface extension {
    record metadata {
        id: string,
        name: string,
        version: string,
        description: string,
    }

    get-metadata: func() -> metadata;
    init: func(config: string) -> result<_, string>;
    view: func() -> string;
}

// Data tools: list + execute. Module-level functions (no resource).
interface tool-provider {
    use types.{column-def};

    record activity {
        present: string,
        past: string,
        subject-field: string,
    }

    record tool-info {
        id: string,
        name: string,
        description: string,
        schema: string,
        cacheable: bool,
        activity: option<activity>,
        examples: list<string>,
    }

    record text-output {
        content: string,
        label: option<string>,
        source: option<string>,
        description: option<string>,
        nickname: option<string>,
        store: option<bool>,
    }

    record data-frame-output {
        schema: list<column-def>,
        // Columnar data as an Arrow IPC byte buffer (R1 wire format). Replaced
        // the legacy JSON `rows` string: no host-side JSON parse, no per-cell
        // allocation, and bit-exact floats (the JSON path silently drifts
        // computed f64 cells by up to 1 ULP). The buffer is self-describing;
        // `schema` above carries display aliases the Arrow schema does not.
        arrow-ipc: list<u8>,
        metadata: option<string>,
        label: option<string>,
        source: option<string>,
        description: option<string>,
        nickname: option<string>,
        store: option<bool>,
    }

    variant tool-output {
        text-output(text-output),
        data-frame-output(data-frame-output),
    }

    list-tools: func() -> list<tool-info>;
    execute-tool: func(name: string, params: string) -> result<tool-output, string>;
}

// Block types + operations. Module-level functions.
interface block-provider {
    record block-type-info {
        kind: string,
        name: string,
        description: string,
    }

    record operation-def {
        name: string,
        description: string,
        schema: string,
    }

    variant plan-outcome {
        state-update(string),
        query(string),
        state-update-with-query(tuple<string, string>),
        computed(string),
        state-update-with-computed(tuple<string, string>),
    }

    get-block-types: func() -> list<block-type-info>;
    create: func(kind: string, input: string) -> result<string, string>;
    plan: func(kind: string, state: string, operation: string, input: string) -> result<plan-outcome, string>;
    validate: func(kind: string, state: string) -> result<_, string>;
}

// Formula functions. Module-level functions.
interface formula-provider {
    record formula-def {
        name: string,
        description: string,
        schema: string,
    }

    get-formulas: func() -> list<formula-def>;
    evaluate: func(name: string, args: string) -> result<string, string>;
}

// Data capability: declarative, UI-builder-facing surface. A sibling to
// tool-provider — NEVER a replacement. tool-provider stays the imperative LLM
// affordance (execute_sql); data-provider drives the dashboard/tile builder so
// a non-technical user picks a source -> fills a typed param form (or drills) ->
// the host knows the output schema BEFORE fetch. See
// docs/ui-data-capability-protocol.md.
interface data-provider {
    use types.{column-def};

    // What the host can pull from this configured instance. `input` says how the
    // host gathers what `fetch` needs; `output` says what the host knows about
    // the result shape before fetch (the keystone — a known schema seeds the
    // measure/axis pickers immediately, no fetch required).
    /// Row-level cardinality of a data source's output.
    enum cardinality {
        /// Tabular relation (enables aggregation).
        rows,
        /// Single observation (blocks aggregation).
        single-record,
        /// One headline value.
        scalar,
    }

    record data-source {
        id: string,
        display-name: string,
        description: string,
        input: input-spec,
        output: output-contract,
        cardinality: cardinality,
    }

    // How the host gathers fetch inputs.
    variant input-spec {
        // Typed param form driven by a JSON-Schema string (same shape as
        // tool-info.schema). v1a.
        params(string),
        // Drill-down tree via `browse`. v1b.
        browse,
        // A browse selection plus params layered on top. v1b+.
        params-and-browse(string),
        // Free-form text the extension compiles into a query; output is always
        // `resolved`. v1b.
        free-query(free-query-spec),
    }

    record free-query-spec {
        language: string,    // "sql" | "promql" | "text" | ...
        placeholder: string,
    }

    // What the host knows about output shape before fetch.
    variant output-contract {
        // Statically known regardless of input — host seeds schema now.
        known(output-spec),
        // Knowable only after the selection is made — host calls
        // `output-schema(source, selection)` once the user has chosen. v1b.
        resolved,
    }

    // The output shape. Maps onto the host's projection shape: `rows` -> a
    // tabular relation, `scalar` -> a single headline value, `finished` -> a
    // complete resource the host references without reshaping.
    variant output-spec {
        rows(list<column-def>),
        scalar(column-def),
        finished,
    }

    // --- Catalog discovery -------------------------------------------------

    // Runtime catalog. For static catalogs the host may skip this and read the
    // manifest `[[data_sources]]` mirror; `is-catalog-dynamic` says which.
    list-sources: func() -> result<list<data-source>, data-error>;
    is-catalog-dynamic: func() -> bool;

    // --- Browse (one level per call; paginated) — v1b ----------------------

    // Kind of entity a node represents, rendered by the host as a chip beside
    // the label (never baked into the label text). Typed cases are reserved
    // for kinds the host styles distinctly; everything else starts life as
    // `custom` ("materialized view", "custom object", "board", …) and is
    // promoted to a typed case only once the host treats it specially.
    variant node-tag {
        table,
        view,
        custom(string),
    }

    record node {
        id: string,
        label: string,
        // true -> descendable (call browse again with this appended to path);
        // false -> a selectable leaf.
        branch: bool,
        // present on leaves whose output shape is known at browse time.
        output: option<output-spec>,
        // present when the node kind is worth surfacing (e.g. view vs table).
        tag: option<node-tag>,
    }

    record page {
        nodes: list<node>,
        next-cursor: option<string>,
    }

    // `path` is a JSON array of node ids from root (e.g. `[]`, `["conn_prod"]`).
    browse: func(
        source: string,
        path: string,
        cursor: option<string>,
        limit: u32,
    ) -> result<page, data-error>;

    // --- Output schema (when output-contract is `resolved`) — v1b ----------

    output-schema: func(
        source: string,
        selection: string,   // JSON Selection
    ) -> result<output-spec, data-error>;

    // --- Fetch -------------------------------------------------------------

    // The extension OWNS query construction; the host hands a Selection. Result
    // data crosses as an Arrow IPC buffer — the SAME wire as
    // tool-provider.data-frame-output (R1) — so fetch is Arrow-native from day
    // one with no JSON payload to retrofit.
    record fetch-result {
        // Columnar result as an Arrow IPC buffer (rows/scalar). Empty for a
        // `finished` output, where `resource-id` carries the landed reference.
        arrow-ipc: list<u8>,
        // Set only for `finished` outputs.
        resource-id: option<string>,
        // Pagination continuation; absent => complete. Always absent in v1a
        // (eager buffer); the v1b export cursor sets it.
        next-cursor: option<string>,
    }

    fetch: func(
        source: string,
        selection: string,   // JSON Selection
    ) -> result<fetch-result, data-error>;

    // --- Typed error taxonomy ----------------------------------------------

    variant data-error {
        auth-failed(string),         // bad/expired credentials -> "Reconnect"
        not-found(string),           // source/path/table gone
        invalid-selection(string),   // host built a Selection the ext rejects
        rate-limited(rate-limit),    // back off; "try again in N s"
        transient(string),           // network blip; offer retry
        unsupported(string),         // capability not implemented for this source
        internal(string),            // catch-all; generic message + logged detail
    }

    record rate-limit {
        message: string,
        retry-after-secs: option<u32>,
    }
}

// ----------------------------------------------------------------------------
// Imported interfaces (host -> extension services)
// ----------------------------------------------------------------------------

// Streaming cursor access to host-managed data.
interface host-data {
    use types.{column-def};

    resource cursor {
        open: static func(resource-id: string, query: string) -> result<cursor, string>;
        // Yields up to `batch-size` rows as one Arrow IPC batch buffer (R2 —
        // was a JSON string). `none` signals EOF.
        next-batch: func(batch-size: u32) -> result<option<list<u8>>, string>;
        close: func();
    }

    get-schema: func(resource-id: string) -> result<list<column-def>, string>;
    row-count: func(resource-id: string) -> result<u64, string>;
}

// Extension -> host push notifications (progress, invalidation, tool-changed).
interface host-events {
    record progress {
        percent: option<u8>,
        message: string,
    }

    variant invalidate {
        %resource(string),
        tool(string),
        all,
    }

    variant event {
        progress(progress),
        tools-changed,
        invalidate(invalidate),
    }

    notify: func(event: event);
}

// ----------------------------------------------------------------------------
// Worlds (additive tiers)
// ----------------------------------------------------------------------------

world tool-extension {
    import host-events;
    export extension;
    export tool-provider;
}

world block-extension {
    include tool-extension;
    export block-provider;
}

world rich-extension {
    include block-extension;
    export formula-provider;
}

world full-extension {
    include rich-extension;
    import host-data;
}

// Data capability tier: tool-provider (LLM) + data-provider (UI builder).
// A SECOND branch off tool-extension, orthogonal to the block/formula chain —
// a data extension (SQL, AlphaVantage) wants tool + data without empty block or
// formula exports. See docs/ui-data-capability-protocol.md §2.2 (D-DATA-1) and
// d:extension-payload-strategy.
world data-extension {
    include tool-extension;
    export data-provider;
}
